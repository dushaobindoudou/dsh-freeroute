{
  "name": "dsh-freeroute",
  "version": "0.10.0",
  "description": "Free-tier model aggregation for the DeepSeek Harness (dsh): registers the freeroute provider over a pool of free-quota upstreams (OpenCode Zen / B.AI / OpenRouter / SenseNova built in, plus remote catalogs and custom gateways), transparent failover before first token, multi-key rotation with per-key failure visibility, user-supplied API keys with per-upstream signup tutorials, a settings panel, and an OpenAI-compatible local endpoint.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:static": "npm run build:dynamic && node scripts/build-static.mjs && node scripts/build-static-client.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node test/smoke.mjs && node freeroute-dynamic/test/integration.mjs && node freeroute-dynamic/test/client-integration.mjs",
    "prepublishOnly": "npm run build:static && npm run lint && npm test",
    "build:dynamic": "node scripts/build-dynamic.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/dsh-freeroute.git"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-freeroute",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-freeroute/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "openrouter",
    "free-tier",
    "llm-routing",
    "failover",
    "openai-compatible"
  ],
  "author": "dushaobindoudou",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1"
  }
}
